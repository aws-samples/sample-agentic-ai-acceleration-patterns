// Type-checks and lints the example validators with the project's compiler
// options. The demo stack bundles them with esbuild; nothing is emitted here.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".."
  },
  "include": ["**/*.ts"]
}
