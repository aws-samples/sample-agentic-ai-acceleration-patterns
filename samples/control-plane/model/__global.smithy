$version: "2.0"

namespace controlplane

use aws.apigateway#authorizers
use aws.apigateway#integration
use aws.apigateway#requestValidator
use aws.protocols#restJson1
use smithy.framework#ValidationException

/// The cell-based control plane. Manages application, account, cell, tenant
/// and deployment lifecycle for one or more multi-tenant applications using
/// the cell deployment model: a cell is a deployment unit of one application
/// containing one shared application deployment plus up to maxTenants
/// per-tenant deployments. A tenant is a customer; a deployment is the tenant
/// in one application. Cells live in registered AWS accounts (vendor-owned
/// fleet accounts or a customer's tenant-owned account) and are created
/// implicitly by deployment placement; deployments are provisioned by
/// running lifecycle scripts in AWS CodeBuild under a role pair installed in
/// the cell's account. All operations require a vendor IdP JWT validated by
/// a Lambda Authorizer.
@title("Cell-Based Control Plane - Tenant Service")
@restJson1
@httpApiKeyAuth(name: "Authorization", in: "header")
@authorizers(
    "vendor-authorizer": {
        scheme: "smithy.api#httpApiKeyAuth"
        type: "token"
        uri: "PLACEHOLDER"
        identitySource: "method.request.header.Authorization"
        // Explicit, not the implicit 300s default: the policy covers the
        // whole stage (cached per token), so the TTL bounds how long a
        // revoked or expired token keeps access. 60s trades some cache hit
        // rate for a tighter revocation window.
        resultTtlInSeconds: 60
    }
)
@integration(type: "aws_proxy", httpMethod: "POST", uri: "PLACEHOLDER")
// API Gateway validates request bodies and parameters against the generated
// OpenAPI schemas before they reach the Lambda integration (AwsSolutions-APIG2).
// The SSDK still re-validates - gateway validation is defence in depth.
@requestValidator("full")
service TenantService {
    version: "2026-09-03"
    resources: [
        Application
        Tenant
        Deployment
        Cell
        Account
    ]
    errors: [
        ValidationException
        UnauthorizedError
        InternalServerError
    ]
}

// ---------------------------------------------------------------------------
// Common types
// ---------------------------------------------------------------------------

/// Unique tenant identifier (ULID), generated by the control plane when the
/// tenant is created.
@pattern("^[0-9A-HJKMNP-TV-Z]{26}$")
string TenantId

/// Human-readable tenant name.
@length(min: 1, max: 128)
string TenantName

/// Free-text tenant description.
@length(max: 1024)
string TenantDescription

/// Email address of a deployment's first customer administrator.
/// Pass-through onboarding input: forwarded to the tenant create script as
/// ADMIN_EMAIL and never persisted.
@pattern("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")
@length(min: 3, max: 254)
string EmailAddress

/// ISO 8601 timestamp.
@timestampFormat("date-time")
timestamp IsoTimestamp

/// Lifecycle status of a cell or a deployment. Transitional statuses
/// (CREATING, UPDATING, DELETING) act as an optimistic concurrency guard:
/// mutations on an in-flight record are rejected with ConflictError.
enum LifecycleStatus {
    /// The create script is running; the deployment is being provisioned.
    CREATING
    /// The deployment is provisioned and operational.
    ACTIVE
    /// The update script is running; the deployment is being re-applied.
    UPDATING
    /// The delete script is running; the deployment is being deprovisioned.
    DELETING
    /// The create script failed; remediation is delete (cleanup) + recreate.
    CREATE_FAILED
    /// The update script failed; update may be retried or the record deleted.
    UPDATE_FAILED
    /// The delete script failed; delete may be retried.
    DELETE_FAILED
}

/// Opaque pagination token.
@length(min: 1, max: 4096)
string PaginationToken

/// Client-supplied idempotency token. Retrying a request with the same
/// token replays the original outcome instead of repeating its side
/// effects. Tokens are unique per logical request (a UUID is typical) and
/// honoured for at least 24 hours.
@length(min: 1, max: 64)
@pattern("^[A-Za-z0-9_-]+$")
string IdempotencyToken

/// Maximum number of items to return in one page.
@range(min: 1, max: 100)
integer MaxResults

// ---------------------------------------------------------------------------
// Shared deployment definition shapes (CodeBuild ProjectSource subset +
// script locations). Registered on the application (ADR-032) and stamped
// onto cell records at creation; tenants and deployments carry no source or
// scripts of their own.
// ---------------------------------------------------------------------------

/// The type of repository that contains the provisioning source.
/// A modelled subset of the AWS CodeBuild ProjectSource type field:
/// CODEPIPELINE and NO_SOURCE are excluded as meaningless for script sources.
enum SourceType {
    /// Source in an AWS CodeCommit repository.
    CODECOMMIT
    /// Source in a GitHub repository.
    GITHUB
    /// Source in a GitHub Enterprise Server repository.
    GITHUB_ENTERPRISE
    /// Source in a GitLab repository.
    GITLAB
    /// Source in a self-managed GitLab repository.
    GITLAB_SELF_MANAGED
    /// Source in a Bitbucket repository.
    BITBUCKET
    /// Source in an Amazon S3 bucket.
    S3
}

/// Location of the provisioning source: an HTTPS clone URL for repository
/// types, or bucket/path for S3, per CodeBuild ProjectSource.location
/// semantics. Must start with a non-blank character.
@length(min: 1, max: 2048)
@pattern("^\\S")
string SourceLocation

/// Path to a provisioning script, relative to the source root
/// (for example "scripts/create.sh"). Must start with a non-blank character.
@length(min: 1, max: 1024)
@pattern("^\\S")
string ScriptPath

/// A git ref forwarded to CodeBuild StartBuild as SourceVersion. A full
/// 40-character commit SHA pins the provisioning source immutably (threat
/// model T5, mitigation M10); a branch or tag is a mutable ref and is
/// accepted with a logged warning (ADR-020).
@length(min: 1, max: 256)
@pattern("^[^\\s]+$")
string SourceVersion

/// The build input source for lifecycle provisioning - a modelled subset of
/// the AWS CodeBuild ProjectSource, containing only what StartBuild
/// per-execution overrides need. Registered on the application and stamped
/// onto each cell record at creation.
structure SourceDefinition {
    /// The repository type containing the provisioning source.
    @required
    type: SourceType

    /// The source location (HTTPS clone URL or bucket/path).
    @required
    location: SourceLocation

    /// Optional git ref (branch, tag or full commit SHA). Absent, builds
    /// fetch the source's default branch HEAD.
    sourceVersion: SourceVersion
}

/// Locations of the three lifecycle scripts within the source, relative to
/// the source root. The matching script is executed in AWS CodeBuild for
/// each lifecycle operation. Empty deployments are represented by explicit,
/// idempotent no-op scripts - all three locations are always required.
structure ScriptLocations {
    /// Script run when the deployment is created.
    @required
    create: ScriptPath

    /// Script run when the deployment is updated (re-applied).
    @required
    update: ScriptPath

    /// Script run when the deployment is deleted (deprovisioned).
    @required
    delete: ScriptPath
}

// ---------------------------------------------------------------------------
// Parameters (ADR-039, ADR-040). An application declares the parameters its
// tenant scripts take and the cell parameters its cell scripts take; values
// are stored on the deployment or the cell and reach the scripts as
// PARAM_<NAME> environment variables. Values are plain text and must not be
// secrets (spec N-11).
// ---------------------------------------------------------------------------

/// A parameter name: an upper-case letter, then up to 63 upper-case letters,
/// digits or underscores. The script receives it as PARAM_<NAME>.
@pattern("^[A-Z][A-Z0-9_]{0,63}$")
string ParameterName

/// A parameter value or default: at most 1,024 bytes of UTF-8 with no
/// control characters (U+0000 to U+001F, U+007F). The service checks the
/// byte length and the characters; the model bounds the length.
@length(max: 1024)
string ParameterValue

/// Operator-facing text describing a parameter.
@length(max: 256)
string ParameterDescription

/// One parameter the application's tenant scripts take (ADR-039). A
/// required parameter has no default; an optional one may have a default,
/// which a deployment without its own value receives.
structure ParameterDeclaration {
    /// The parameter name, unique across both of the application's lists.
    @required
    name: ParameterName

    /// Whether every deployment must have a value. Default false.
    required: Boolean

    /// The value a deployment without its own value receives. Not allowed on
    /// a required parameter.
    default: ParameterValue

    /// What the parameter is for.
    description: ParameterDescription
}

/// One parameter the application's cell scripts take (ADR-040). Every cell
/// parameter has a default: a cell is created by placement, when no operator
/// is present to supply a value.
structure CellParameterDeclaration {
    /// The parameter name, unique across both of the application's lists.
    @required
    name: ParameterName

    /// The value a cell without its own value receives.
    @required
    default: ParameterValue

    /// What the parameter is for.
    description: ParameterDescription
}

/// The parameters an application's tenant scripts take, at most 20.
@length(max: 20)
list ParameterDeclarationList {
    member: ParameterDeclaration
}

/// The parameters an application's cell scripts take, at most 20.
@length(max: 20)
list CellParameterDeclarationList {
    member: CellParameterDeclaration
}

/// Parameter values by name, at most 20 entries. Defaults are never stored:
/// a map holds the values an operator supplied.
@length(max: 20)
map ParameterMap {
    key: ParameterName
    value: ParameterValue
}

/// Names of stored parameter values to remove, at most 40. A name that is
/// not stored is a no-op.
@length(max: 40)
list ParameterNameList {
    member: ParameterName
}

// ---------------------------------------------------------------------------
// Errors
// ---------------------------------------------------------------------------

/// The requested tenant, deployment, cell, account or application does not
/// exist - including an unregistered accountId or applicationId named by
/// CreateDeployment, and an unregistered application named in
/// PutAccount.applicationIds.
@error("client")
@httpError(404)
structure ResourceNotFoundError {
    /// Details of what was not found.
    @required
    message: String
}

/// The request conflicts with the record's current state - for example a
/// mutation on an in-flight deployment or cell (CREATING/UPDATING/DELETING),
/// an update from CREATE_FAILED (remediation is delete + recreate), a tenant
/// build while the cell is not ACTIVE, a second deployment of the same
/// application for one tenant, deleting a tenant that still has
/// deployments, deleting a cell that still holds deployments, deleting an
/// account or application that still holds cells, changing a registered
/// account's owner, a CreateDeployment clientToken reused with different
/// parameters, a parameter merge (UpdateDeployment, UpdateCell) or a
/// PutApplication that keeps a declaration list whose read went stale
/// (retry - spec R-14), or a CreateDeployment that lost every bounded
/// placement claim on candidate cells while no account had a free cell
/// slot (nothing was written; retry - ADR-031). The message says when a
/// retry can succeed.
@error("client")
@httpError(409)
structure ConflictError {
    /// Details of the conflicting state.
    @required
    message: String
}

/// CreateDeployment found no eligible cell and no eligible account with
/// cell capacity: every vendor-owned account admitting the application is
/// full (untargeted), or the named account is full (targeted). Nothing was
/// written. Unlike ConflictError this will not clear by waiting - an
/// operator must raise maxCells, register an account, or admit the
/// application in one (ADR-026).
@error("client")
@httpError(409)
structure InsufficientCapacityError {
    /// Which limit was hit.
    @required
    message: String
}

/// The caller's vendor IdP JWT is missing, invalid, or insufficient.
@error("client")
@httpError(403)
structure UnauthorizedError {
    /// Details of the authorization failure.
    @required
    message: String
}

/// An unexpected server-side failure - including missing service context or
/// configuration, which indicates a bug at the ingress layer rather than a
/// client error.
@error("server")
@httpError(500)
structure InternalServerError {
    /// Details of the failure.
    @required
    message: String
}
