{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bundle": {
      "name": "bundle",
      "description": "Prepare assets"
    },
    "check:headers": {
      "name": "check:headers",
      "description": "MIT-0 header on every authored .py, Dockerfile and shell file",
      "steps": [
        {
          "exec": "scripts/check-headers.sh"
        }
      ]
    },
    "check:terms": {
      "name": "check:terms",
      "description": "No banned terms, account ids or account aliases in the tree",
      "steps": [
        {
          "exec": "scripts/check-terms.sh"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "tsc --build"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "ts-node",
            "--project",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "deploy": {
      "name": "deploy",
      "description": "Deploys your CDK app to the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "destroy": {
      "name": "destroy",
      "description": "Destroys your cdk app in the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "destroy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "diff": {
      "name": "diff",
      "description": "Diffs the currently deployed app against your code",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "diff"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "execArgs": [
            "eslint",
            "--ext",
            ".ts,.tsx",
            "--fix",
            "--no-error-on-unmatched-pattern",
            "$@",
            "src",
            "test",
            "build-tools",
            "projenrc",
            ".projenrc.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "npm install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "npm ci"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "exec": "ts-node --project projenrc/tsconfig.json projenrc/copy-handlers.ts"
        },
        {
          "spawn": "synth:silent"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "synth": {
      "name": "synth",
      "description": "Synthesizes your cdk app into cdk.out",
      "steps": [
        {
          "exec": "cdk synth --context backends=microvm,nitro,agentcore --context standalone=true"
        }
      ]
    },
    "synth:silent": {
      "name": "synth:silent",
      "description": "Synthesizes your cdk app into cdk.out and suppresses the template in stdout (part of \"yarn build\")",
      "steps": [
        {
          "exec": "cdk synth -q --context backends=microvm,nitro,agentcore --context standalone=true"
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--passWithNoTests",
            "--updateSnapshot"
          ],
          "receiveArgs": true
        },
        {
          "spawn": "eslint"
        },
        {
          "spawn": "test:runner"
        },
        {
          "spawn": "check:headers"
        },
        {
          "spawn": "check:terms"
        }
      ]
    },
    "test:runner": {
      "name": "test:runner",
      "description": "Python unit tests of the runner and the protocol vectors",
      "steps": [
        {
          "exec": "python3 -B -m unittest discover -s runner/tests -t ."
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run jest in watch mode",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--watch"
          ]
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "exec": "npm install"
        },
        {
          "execArgs": [
            "npm",
            "update",
            "@aws-sdk/client-cloudformation",
            "@aws-sdk/client-cognito-identity-provider",
            "@aws-sdk/client-iam",
            "@aws-sdk/client-lambda",
            "@aws-sdk/client-ssm",
            "@stylistic/eslint-plugin",
            "@types/aws-lambda",
            "@types/jest",
            "@types/node",
            "@typescript-eslint/eslint-plugin",
            "@typescript-eslint/parser",
            "agentic-runtime-isolation",
            "aws-cdk",
            "aws-sdk-client-mock-jest",
            "aws-sdk-client-mock",
            "cdk-nag",
            "eslint-import-resolver-typescript",
            "eslint-plugin-import",
            "eslint",
            "jest-junit",
            "jest",
            "projen",
            "ts-jest",
            "ts-node",
            "typescript",
            "@aws-sdk/client-bedrock-agentcore-control",
            "@aws-sdk/client-bedrock-agentcore",
            "@aws-sdk/client-cloudwatch-logs",
            "@aws-sdk/client-dynamodb",
            "@aws-sdk/client-ec2",
            "@aws-sdk/client-ecs",
            "@aws-sdk/client-lambda-microvms",
            "@aws-sdk/client-s3",
            "@aws-sdk/client-sts",
            "@aws-sdk/lib-dynamodb",
            "aws-cdk-lib",
            "cdk-ecr-deployment",
            "constructs",
            "esbuild"
          ]
        },
        {
          "exec": "npx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watches changes in your source code and rebuilds and deploys to the current account",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy",
            "--hotswap"
          ]
        },
        {
          "execArgs": [
            "cdk",
            "watch"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
